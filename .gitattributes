# Normalise line endings in the repository, and check text out as LF
# everywhere. The project builds on Windows, and `make_app.sh` and the Python
# tools break outright if they arrive with CRLF.
* text=auto eol=lf

# Never touched: these are compared byte-for-byte in tests, and a line-ending
# rewrite would corrupt them silently.
*.png   binary
*.webp  binary
*.gif   binary
*.rsrc  binary
*.img   binary
*.iso   binary
*.ROM   binary

# Vendored third-party source. Kept out of language statistics and collapsed in
